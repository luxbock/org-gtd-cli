# Python bytecode / pytest caches
__pycache__/
*.py[cod]
.pytest_cache/

# Hypothesis state: scratch dir + the local example-DB cache
# (.hypothesis-examples/, configured in conftest.py — deliberately NOT
# committed; see README "Semantics tests")
.hypothesis/
.hypothesis-examples/

# Byte-compiled elisp
*.elc

# trash-cli local fallback trash (created when `trash` runs on this mount)
.Trash-*/

# Claude Code session state (agent worktrees, local settings)
.claude/
